# Copy to .dev.vars (gitignored) for local development. Throwaway values only, never reuse them.
# Secrets must be 32 random bytes, base64url (the API answers 503 server_misconfigured otherwise):
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
