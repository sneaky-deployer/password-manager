{
  "name": "password-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@pm/api' --filter '@pm/web' dev",
    "build": "bun run --filter '@pm/web' build && bun run --filter '@pm/api' build",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter '@pm/api' db:generate",
    "db:migrate:local": "bun run --filter '@pm/api' db:migrate:local",
    "db:migrate:remote": "bun run --filter '@pm/api' db:migrate:remote",
    "deploy": "bun run build && bun run --filter '@pm/api' deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "typescript": "^7.0.2"
  }
}
